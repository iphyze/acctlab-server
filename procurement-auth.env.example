# Procurement authentication. A separate secret is recommended; JWT_SECRET is used as fallback.
PROCUREMENT_JWT_SECRET=replace_with_at_least_32_random_characters
PROCUREMENT_JWT_ISSUER=acctlab-procurement-api
PROCUREMENT_JWT_AUDIENCE=acctlab-procurement-web
PROCUREMENT_JWT_ACCESS_EXPIRES_IN=900
PROCUREMENT_REFRESH_TOKEN_EXPIRES_IN=2592000
PROCUREMENT_LOGIN_MAX_ATTEMPTS=5
PROCUREMENT_REFRESH_COOKIE_NAME=acctlab_procurement_refresh
PROCUREMENT_CSRF_COOKIE_NAME=acctlab_procurement_csrf
PROCUREMENT_AUTH_COOKIE_PATH=/acctlab-server/api/procurement

# Add the procurement frontend origin to the existing comma-separated allowlist.
# ALLOWED_ORIGINS=https://accounting.example.com,https://procurement.example.com
