# Cloudflare R2 S3-compatible credentials. Keep these values only on the PHP API server.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=acctlab-procurement-documents-prod

# Optional. Defaults shown below.
# R2_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com
R2_REGION=auto
R2_UPLOAD_URL_TTL_SECONDS=600
R2_ACCESS_URL_TTL_SECONDS=300
